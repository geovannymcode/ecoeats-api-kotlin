# Export variables before bootRun; Spring does not automatically load .env.
SPRING_PROFILES_ACTIVE=local
PORT=8080
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecoeats
PGUSER=postgres
PGPASSWORD=postgres
# Railway private network: disable. Public database URL: require.
PGSSLMODE=disable
JWT_SECRET=example-only-replace-with-at-least-32-random-bytes
JWT_EXPIRATION=24h
# Empty in local development: use LoggingEmailSender instead of Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=EcoEats
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Local development only; use a different secret outside local development.
SEED_ADMIN_PASSWORD=123456
# MinIO local; use Railway bucket Credentials values in production.
BUCKET=ecoeats-local
ENDPOINT=http://localhost:9000
REGION=us-east-1
ACCESS_KEY_ID=minioadmin
SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
IMAGE_URL_TTL=24h
# Set the deployed public API URL in production; omitted until configured.
PUBLIC_URL=
SPRINGDOC_ENABLED=true
